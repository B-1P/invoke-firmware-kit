#!/bin/sh
# Multi-call stub that imitates the speaker's networking tools for test/sim.sh.
# State lives in $SIM (files). Nothing here touches real networking.
#   $SIM/router_on        - the home router is reachable
#   $SIM/good_ssid        - hex SSID of the home network
#   $SIM/good_psk         - psk value that works (what the make-conf stub writes)
#   $SIM/dhcp_needs_kick  - router only answers after dhcpcd is (re)kicked
#   $SIM/wpastate, ip, disconnected, temp_disabled - wpa_supplicant/interface state
#   $SIM/sta_freq, sta_chan - where the home router is (default 2462 MHz / ch 11)
#   $SIM/bad_channels     - channels on which hostapd fails ("Failed to set beacon")
#   $SIM/hostapd_fails    - hostapd fails on every channel
# Like the real SD8887, the AP only starts on the station's channel while the
# station is associated. hostapd also checks what the real one needs after it
# drops root to user "wifi" (readable config, usable directory, no stale ctrl dir).
: "${SIM:?}"
name=$(basename "$0")
rec() { echo "$name $*" >> "$SIM/calls"; }

conf_val() { sed -n "s/^[[:space:]]*$1=//p" "$SIM_WIFI_CONF" | head -n 1; }

attempt() {     # what happens when wpa_supplicant tries the configured network
    rm -f "$SIM/temp_disabled"
    [ -f "$SIM/disconnected" ] && return
    ssid=$(conf_val ssid); psk=$(conf_val psk)
    if [ -z "$ssid" ]; then echo DISCONNECTED > "$SIM/wpastate"; return; fi
    if [ ! -f "$SIM/router_on" ] || [ "$ssid" != "$(cat "$SIM/good_ssid")" ]; then
        echo SCANNING > "$SIM/wpastate"; return
    fi
    if [ "$psk" != "$(cat "$SIM/good_psk")" ]; then
        echo 4WAY_HANDSHAKE > "$SIM/wpastate"; touch "$SIM/temp_disabled"; return
    fi
    echo COMPLETED > "$SIM/wpastate"
    [ -f "$SIM/dhcp_needs_kick" ] || echo 10.0.0.5 > "$SIM/ip"
}

case "$name" in
wpa_cli)
    while [ $# -gt 0 ]; do case "$1" in -p|-i) shift 2 ;; *) break ;; esac; done
    rec "$@"
    case "$1" in
        ping) [ -f "$SIM/wpa_dead" ] || echo PONG ;;
        status) echo "wpa_state=$(cat "$SIM/wpastate" 2>/dev/null || echo DISCONNECTED)"
                if [ "$(cat "$SIM/wpastate" 2>/dev/null)" = COMPLETED ]; then
                    echo "freq=$(cat "$SIM/sta_freq" 2>/dev/null || echo 2462)"; echo "ssid=home"; fi ;;
        list_networks)
            echo "network id / ssid / bssid / flags"
            n=$(grep -c '^network={' "$SIM_WIFI_CONF" 2>/dev/null)
            i=0; while [ "$i" -lt "${n:-0}" ]; do
                f=; [ -f "$SIM/temp_disabled" ] && f='[TEMP-DISABLED]'
                printf '%s\tnet\tany\t%s\n' "$i" "$f"; i=$((i + 1)); done ;;
        reconfigure) attempt ;;
        reconnect|enable_network) rm -f "$SIM/disconnected"; attempt ;;
        disconnect) touch "$SIM/disconnected"; echo DISCONNECTED > "$SIM/wpastate"; rm -f "$SIM/ip" ;;
        scan) echo OK ;;
        scan_results) printf 'bssid / frequency / signal level / flags / ssid\n02:00:00:00:00:01\t2437\t-50\t[WPA2-PSK-CCMP][ESS]\thome\n' ;;
    esac ;;
ifconfig)
    rec "$@"
    if [ "$1" = wlan0 ] && [ $# = 1 ]; then
        echo "wlan0     Link encap:Ethernet  HWaddr d8:00:00:00:12:ab"
        [ -f "$SIM/ip" ] && echo "          inet addr:$(cat "$SIM/ip")  Bcast:10.0.0.255  Mask:255.255.255.0"
    elif [ "$1" = wlan0 ] && [ "$2" = 0.0.0.0 ]; then rm -f "$SIM/ip"
    elif [ "$1" = p2p0 ] && [ "$2" = down ]; then rm -f "$SIM/p2p0_ip"
    elif [ "$1" = p2p0 ]; then echo "$2" > "$SIM/p2p0_ip"
    fi ;;
hostapd)
    rec "$@"
    conf=$1
    lc() { echo "$1/hostapd ( $$): $2" >> "$SIM/logcat"; }
    dir=$(dirname "$conf")
    m=$(stat -c %a "$conf"); dm=$(stat -c %a "$dir")
    case "$m" in 644|640) ;; *) echo "conf mode $m" >> "$SIM/perm_errors" ;; esac
    case "$dm" in 777|770) ;; *) echo "dir mode $dm" >> "$SIM/perm_errors" ;; esac
    ctrl=$(sed -n 's/^ctrl_interface=//p' "$conf")
    [ -e "$ctrl" ] && echo "stale ctrl dir $ctrl" >> "$SIM/perm_errors"
    ch=$(sed -n 's/^channel=//p' "$conf")
    echo "$ch" >> "$SIM/hostapd_channels"
    lc E "Configuration file: $conf"
    fail=
    [ -f "$SIM/hostapd_fails" ] && fail=1
    case " $(cat "$SIM/bad_channels" 2>/dev/null) " in *" $ch "*) fail=1 ;; esac
    if [ "$(cat "$SIM/wpastate")" = COMPLETED ] &&
       [ "$ch" != "$(cat "$SIM/sta_chan" 2>/dev/null || echo 11)" ]; then fail=1; fi
    if [ -n "$fail" ]; then
        lc E "Failed to set beacon parameters"; lc E "Interface initialization failed"
        exit 1
    fi
    lc I "p2p0: AP-ENABLED "
    mkdir -p "$ctrl"
    echo $$ > "$SIM/hostapd_running"
    exec sleep 100000 ;;
dnsmasq)
    rec "$@"
    pidf=
    while [ $# -gt 0 ]; do case "$1" in -x) pidf=$2; shift 2 ;; *) shift ;; esac; done
    sleep 100000 < /dev/null > /dev/null 2>&1 &
    echo $! > "$pidf" ;;
logcat)
    cat "$SIM/logcat" 2>/dev/null ;;
hostapd_cli)
    rec "$@"
    case "$*" in
        *status*) p=$(cat "$SIM/hostapd_running" 2>/dev/null)
                  [ -n "$p" ] && kill -0 "$p" 2>/dev/null && echo "state=ENABLED" ;;
        *all_sta*) [ -f "$SIM/ap_clients" ] && echo "02:11:22:33:44:55" ;;
    esac ;;
python)
    if [ "$1" = --make-conf ] || [ "$2" = --make-conf ]; then
        out=$3; [ "$1" = --make-conf ] && out=$2
        read -r s; read -r p
        { echo "ctrl_interface=/data/wifi"; echo "update_config=1"; echo
          echo "network={"
          echo "	ssid=$(printf '%s' "$s" | od -An -tx1 | tr -d ' \n')"
          if [ -n "$p" ]; then echo "	psk=$(printf '%s' "$p" | od -An -tx1 | tr -d ' \n')"
          else echo "	key_mgmt=NONE"; fi
          echo "}"; } > "$out"
    else
        rec portal
        exec sleep 100000
    fi ;;
dhcpcd)
    rec "$@"
    [ -f "$SIM/dhcp_needs_kick" ] && [ "$(cat "$SIM/wpastate")" = COMPLETED ] && echo 10.0.0.5 > "$SIM/ip" ;;
setprop)
    rec "$@"
    case "$*" in *ctl.start*dhcpcd*)
        [ "$(cat "$SIM/wpastate")" = COMPLETED ] && echo 10.0.0.5 > "$SIM/ip" ;; esac ;;
iptables)
    rec "$@"
    # rules live one per line in $SIM/fw_rules, without the -C/-I/-D
    op=$1; shift; rule="$*"; touch "$SIM/fw_rules"
    case "$op" in
        -C) grep -qxF -- "$rule" "$SIM/fw_rules" ;;
        -I) echo "$rule" >> "$SIM/fw_rules" ;;
        -D) grep -qxF -- "$rule" "$SIM/fw_rules" || exit 1
            awk -v r="$rule" '!d && $0 == r { d = 1; next } { print }' "$SIM/fw_rules" > "$SIM/fw_rules.new"
            mv "$SIM/fw_rules.new" "$SIM/fw_rules" ;;
    esac ;;
simsleep)
    # advance the fake clock instead of really waiting
    read -r up _ < "$SIM/uptime"; echo "$(( ${up%%.*} + ${1%%.*} )).00 0.00" > "$SIM/uptime"
    sleep 0.02 ;;
*) echo "stub: unknown $name" >&2; exit 1 ;;
esac
